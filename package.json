{
  "name": "growlink-projection",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "cron:rollup": "npm run cron:rollup --workspace=server",
    "cron:snapshot": "npm run cron:snapshot --workspace=server",
    "install:all": "npm install && npm install --workspace=client && npm install --workspace=server",
    "cron:forecast-lab": "npm run cron:forecast-lab --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
